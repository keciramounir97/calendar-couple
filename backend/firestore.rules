rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function me() {
      return request.auth.uid;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isSelf(uid) {
      return signedIn() && uid == me();
    }

    function coupleData(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId)).data;
    }

    function isCoupleMember(coupleId) {
      return signedIn()
        && coupleId is string
        && exists(/databases/$(database)/documents/couples/$(coupleId))
        && (
          coupleData(coupleId).bfUid == me()
          || coupleData(coupleId).gfUid == me()
        );
    }

    function listedMember(data) {
      return signedIn()
        && 'members' in data
        && data.members is list
        && me() in data.members;
    }

    match /users/{uid} {
      allow read: if isSelf(uid)
        || (signedIn()
            && resource.data.coupleId is string
            && get(/databases/$(database)/documents/users/$(me())).data.coupleId == resource.data.coupleId);
      allow create: if isSelf(uid)
        && request.resource.data.uid == me()
        && request.resource.data.email == myEmail();
      allow update: if isSelf(uid);
      allow delete: if false;
    }

    match /emailIndex/{emailId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.uid == me()
        && request.resource.data.email == myEmail();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    match /invitations/{id} {
      allow read: if signedIn() && (
        resource.data.fromUid == me()
        || resource.data.toEmail == myEmail()
      );
      allow create: if signedIn()
        && request.resource.data.fromUid == me()
        && request.resource.data.fromEmail == myEmail()
        && request.resource.data.status == 'pending';
      allow update: if signedIn() && (
        resource.data.fromUid == me()
        || resource.data.toEmail == myEmail()
      );
      allow delete: if signedIn() && resource.data.fromUid == me();
    }

    match /couples/{id} {
      allow read: if signedIn() && (
        resource.data.bfUid == me()
        || resource.data.gfUid == me()
        || listedMember(resource.data)
      );
      allow create: if signedIn()
        && (request.resource.data.bfUid == me() || request.resource.data.gfUid == me());
      allow update: if signedIn() && (
        resource.data.bfUid == me()
        || resource.data.gfUid == me()
        || listedMember(resource.data)
      );
      allow delete: if false;
    }

    match /events/{id} {
      allow read: if isCoupleMember(resource.data.coupleId) || listedMember(resource.data);
      allow create: if signedIn()
        && request.resource.data.createdBy == me()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 80
        && isCoupleMember(request.resource.data.coupleId);
      allow update, delete: if isCoupleMember(resource.data.coupleId) || listedMember(resource.data);
    }

    match /logs/{id} {
      allow read: if isCoupleMember(resource.data.coupleId) || listedMember(resource.data);
      allow create: if signedIn()
        && request.resource.data.actorUid == me()
        && isCoupleMember(request.resource.data.coupleId);
      allow update, delete: if false;
    }

    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == me();
      allow create: if signedIn()
        && request.resource.data.title is string
        && request.resource.data.body is string;
      allow update, delete: if signedIn() && resource.data.userId == me();
    }
  }
}
